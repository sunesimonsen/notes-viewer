package templates

import "net/url"
import "strings"
import "github.com/sunesimonsen/notes-viewer/notes"

func noteTitle(entry notes.Entry) string {
  if entry.Title != "" {
    return entry.Title
  }
  return strings.TrimSuffix(entry.ID, ".md")
}

func noteURL(entry notes.Entry) string {
  return "/note/" + entry.Timestamp.Format("20060102T150405")
}

func tagURL(tag string) string {
  return "/tag/" + url.PathEscape(strings.TrimSpace(tag))
}

func currentNote(entry notes.Entry, currentPath string) bool {
  return noteURL(entry) == currentPath
}

templ NoteMenuEntry(entry notes.Entry, currentPath string) {
  <li>
    <a
      href={templ.SafeURL(noteURL(entry))}
      if currentNote(entry, currentPath) {
        aria-current="page"
      }
    >{noteTitle(entry)}</a>
  </li>
}

