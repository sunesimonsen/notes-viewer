package templates

import "github.com/sunesimonsen/notes-viewer/notes"

templ header(entries []notes.Entry, currentPath string) {
  <header>
    <nav>
      <a class="home" href="/"><img src="/assets/logo-transparent-42x42.png" alt="Logo"> Notes</a>
      <div class="header-items">
        <a
        class="ghost icon"
        title="Inbox"
        href="/inbox"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-inbox" viewBox="0 0 16 16">
            <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm9.954 5H10.45a2.5 2.5 0 0 1-4.9 0H1.066l.32 2.562a.5.5 0 0 0 .497.438h12.234a.5.5 0 0 0 .496-.438zM3.809 3.563A1.5 1.5 0 0 1 4.981 3h6.038a1.5 1.5 0 0 1 1.172.563l3.7 4.625a.5.5 0 0 1 .105.374l-.39 3.124A1.5 1.5 0 0 1 14.117 13H1.883a1.5 1.5 0 0 1-1.489-1.314l-.39-3.124a.5.5 0 0 1 .106-.374z"/>
          </svg>
        </a>
        <button
          class="ghost icon"
          type="button"
          title="Starred"
          popovertarget="starred-menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-star" viewBox="0 0 16 16">
            <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.56.56 0 0 0-.163-.505L1.71 6.745l4.052-.576a.53.53 0 0 0 .393-.288L8 2.223l1.847 3.658a.53.53 0 0 0 .393.288l4.052.575-2.906 2.77a.56.56 0 0 0-.163.506l.694 3.957-3.686-1.894a.5.5 0 0 0-.461 0z"/>
          </svg>
        </button>
        <button
          class="ghost icon"
          type="button"
          title="Search"
          command="show-modal"
          commandfor="search-dialog"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
          </svg>
        </button>
      </div>
    </nav>
    <ul id="starred-menu" class="menu" popover>
      for _, entry := range starredEntries(entries) {
        @NoteMenuEntry(entry, currentPath)
      }
    </ul>
  </header>
  <dialog id="search-dialog" class="search" closedby="any">
    <header>
      <p><label for="search-input">Search</label></p>
      @SearchField()
      <button type="button" rel="prev" aria-label="Close" command="close" commandfor="search-dialog" tabindex="1"></button>
    </header>
    <div id="search-results"></div>
  </dialog>
}

templ AuthLayout(part templ.Component) {
  @Page("Notes viewer") {
    <main class="auth">
      <article class="card raised">
        <section>
          @part
        </section>
      </article>
    </main>
  }
}

templ MainLayout(entries []notes.Entry, currentPath string, part templ.Component) {
  @Page("Notes viewer") {
    @header(entries, currentPath)
    <main>
      @part
    </main>
  }
}
